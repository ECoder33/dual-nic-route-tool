<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 浅色配色。颜色取自应用图标：蓝 = 外网，青绿 = 内网，深海军蓝 = 本工具 -->
    <sys:String x:Key="PaletteName">Light</sys:String>

    <!-- 表面 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#E4EAF2" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#D8E0EB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E6EBF2" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="NeutralLineBrush" Color="#C3CCD9" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14213D" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#566275" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8792A5" />

    <!-- 语义色：外网 / 内网 / 品牌 -->
    <SolidColorBrush x:Key="WanBrush" Color="#1877F2" />
    <SolidColorBrush x:Key="WanSoftBrush" Color="#E7F0FE" />
    <SolidColorBrush x:Key="LanBrush" Color="#10A996" />
    <SolidColorBrush x:Key="LanSoftBrush" Color="#E1F6F3" />
    <SolidColorBrush x:Key="BrandBrush" Color="#0B2A66" />

    <!-- 主按钮 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1877F2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F86F5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1266D6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- 状态 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#18945A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4F5EC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B96A00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF3DC" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D03A3A" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FCEBEB" />
</ResourceDictionary>
