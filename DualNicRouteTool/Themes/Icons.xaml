    <!--
        矢量图标集。全部按 24×24 网格手绘为线条图形（圆头、圆角连接），由 Controls/Icon 绘制。
        风格与应用图标保持一致：扁平、几何化、放在圆角方块底上使用。
        键名规则：Icon.<名称>；网卡类型图标的名称与 NicKind 枚举值一一对应。
    -->

    <!-- ============ 网卡类型 ============ -->

    <!-- 以太网：RJ45 接口，与应用图标里的网口同形 -->
    <Geometry x:Key="Icon.Ethernet">M4 9.5 H8 V6 H16 V9.5 H20 V19 H4 Z M8.2 19 V15.2 M10.75 19 V15.2 M13.25 19 V15.2 M15.8 19 V15.2</Geometry>

    <!-- Wi-Fi：三道扇形信号加一个点 -->
