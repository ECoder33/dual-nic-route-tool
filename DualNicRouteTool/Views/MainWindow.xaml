<Window x:Class="DualNicRouteTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DualNicRouteTool.Controls"
        xmlns:m="clr-namespace:DualNicRouteTool.Models"
        xmlns:s="clr-namespace:DualNicRouteTool.Services"
        xmlns:vm="clr-namespace:DualNicRouteTool.ViewModels"
        Title="双网卡路由配置工具"
        Width="1200" Height="820" MinWidth="1200" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app_icon.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- 网卡下拉项：类型图标 + 连接名称 + 设备描述 -->
        <DataTemplate x:Key="NicItemTemplate" DataType="{x:Type m:NicInfo}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SubtleBackgroundBrush}">
                    <c:Icon Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}"
                            Data="{Binding Kind, Converter={StaticResource NicKindToIcon}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text="{Binding KindSuffix, Mode=OneWay}"
                             FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 内网目标网段标签：实心点 = 路由表里已生效 -->
        <DataTemplate x:Key="NetworkChipTemplate" DataType="{x:Type vm:NetworkChipViewModel}">
            <Border x:Name="Chip" Margin="0,3,8,3" Padding="10,4,5,4" CornerRadius="14"
                    Background="{DynamicResource SubtleBackgroundBrush}"
                    ToolTip="{Binding ToolTip}" c:Motion.FadeIn="True">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center"
                             Stroke="{DynamicResource NeutralLineBrush}" StrokeThickness="1.5" />
                    <TextBlock Margin="7,0,6,0" VerticalAlignment="Center" Style="{StaticResource MonoStyle}" Text="{Binding Text}" />
                    <Button Style="{StaticResource ChipCloseButtonStyle}" ToolTip="移除这个网段"
                            Command="{Binding DataContext.RemoveNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource LanSoftBrush}" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource LanBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource LanBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 分步进度：进行中的一步呼吸闪烁，完成打勾，失败打叉 -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type vm:StepViewModel}">
            <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="Ring" Stroke="{DynamicResource NeutralLineBrush}" StrokeThickness="1.6" />
                    <c:Icon x:Name="Mark" Width="9" Height="9" StrokeThickness="3.4" Foreground="White" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="Label" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Label}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static s:StageState.Active}">
                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Ring" Property="c:Motion.Pulse" Value="True" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static s:StageState.Done}">
                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Check}" />
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static s:StageState.Failed}">
                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Close}" />
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 日志行：按级别着色并配图标 -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type m:LogEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource MonoStyle}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TimeText}" />
                <c:Icon x:Name="Glyph" Grid.Column="1" Width="13" Height="13" Margin="9,2,8,0" VerticalAlignment="Top"
                        StrokeThickness="2.2" Foreground="{DynamicResource TextTertiaryBrush}" Data="{StaticResource Icon.Dot}" />
                <TextBlock x:Name="Message" Grid.Column="2" Style="{StaticResource MonoStyle}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Message}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Success}">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Check}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Warning}">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Error}">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Error}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Title}">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.ArrowRight}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Message" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 路由行：左侧圆点和“类别”徽标按所走的网卡着色（蓝 = 外网，青绿 = 内网） -->
        <DataTemplate x:Key="RouteRowTemplate" DataType="{x:Type vm:RouteRowViewModel}">
            <Grid Height="30" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="2.4*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="RoleDot" Width="8" Height="8" HorizontalAlignment="Left" Fill="{DynamicResource NeutralLineBrush}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoStyle}" Text="{Binding Prefix}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MonoStyle}" Text="{Binding Gateway}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Interface}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource MonoStyle}" Text="{Binding Metric}" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding Origin}" />
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Border x:Name="KindBadge" Margin="0,0,6,0" Style="{StaticResource BadgeStyle}">
                        <TextBlock Text="{Binding Kind}" />
                    </Border>
                    <Border Style="{StaticResource BadgeStyle}" Tag="Success"
                            Visibility="{Binding AddedByTool, Converter={StaticResource ToVisibility}}">
                        <TextBlock Text="本工具添加" />
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="Wan">
                    <Setter TargetName="RoleDot" Property="Fill" Value="{DynamicResource WanBrush}" />
                    <Setter TargetName="KindBadge" Property="Tag" Value="Wan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Lan">
                    <Setter TargetName="RoleDot" Property="Fill" Value="{DynamicResource LanBrush}" />
                    <Setter TargetName="KindBadge" Property="Tag" Value="Lan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="">
                    <Setter TargetName="KindBadge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 备份行 -->
        <DataTemplate x:Key="SnapshotTemplate" DataType="{x:Type vm:SnapshotViewModel}">
            <Border Margin="12,0,12,8" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource SubtleBackgroundBrush}" c:Motion.FadeIn="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MonoStyle}" FontWeight="SemiBold" Text="{Binding TimeText}" />
                        <Border Margin="0,5,0,0" HorizontalAlignment="Left" Style="{StaticResource BadgeStyle}"
                                Tag="{Binding Tone}" ToolTip="{Binding StatusHint}">
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="22,0,12,0" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Height="32" Content="恢复"
                                c:IconAssist.Data="{StaticResource Icon.Restore}"
                                Visibility="{Binding CanRestore, Converter={StaticResource ToVisibility}}"
                                Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="删除这份备份"
                                c:IconAssist.Data="{StaticResource Icon.Trash}"
                                Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid Margin="20,14,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="46" Height="46" Source="/Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="双网卡路由配置工具" />
                        <TextBlock Margin="10,0,0,2" VerticalAlignment="Bottom" Style="{StaticResource CaptionStyle}" Text="{Binding VersionText}" />
                    </StackPanel>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="公网流量走外网网卡，指定网段走内网网卡 · 配置前自动备份，随时恢复" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" Style="{StaticResource BadgeStyle}" Padding="10,5" Tag="Success" ToolTip="已获得管理员权限，可以修改路由表">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon x:Name="AdminIcon" Width="14" Height="14" Data="{StaticResource Icon.ShieldCheck}" />
                            <TextBlock x:Name="AdminText" Margin="6,0,0,0" Text="管理员" />
                        </StackPanel>
                    </Border>
                    <Button Margin="10,0,0,0" Style="{StaticResource GhostButtonStyle}" Content="使用说明"
                            c:IconAssist.Data="{StaticResource Icon.Help}" Command="{Binding HelpCommand}" />
                </StackPanel>
            </Grid>

            <!-- ================= 非管理员提示 ================= -->
            <Border x:Name="AdminBar" Grid.Row="1" Margin="0,12,0,0" Padding="14,9" CornerRadius="10"
                    Background="{DynamicResource WarningSoftBrush}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Icon Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" Data="{StaticResource Icon.Warning}" />
                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="当前未以管理员身份运行：可以查看网卡与路由表，但不能配置或恢复路由。" />
                    <Button Grid.Column="2" Height="32" Style="{StaticResource SecondaryButtonStyle}" Content="以管理员身份重启"
                            c:IconAssist.Data="{StaticResource Icon.Shield}" Click="OnRestartAsAdmin" />
                </Grid>
            </Border>

            <!-- ================= 配置区：左侧两张网卡卡片，右侧拓扑图 ================= -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid IsEnabled="{Binding IsIdle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 外网网卡（蓝） -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid x:Name="WanCardContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}" Background="{DynamicResource WanBrush}">
                                    <c:Icon Width="22" Height="22" Data="{StaticResource Icon.Globe}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外网网卡" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="互联网流量的默认出口" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource BadgeStyle}" Tag="Wan"
                                        Visibility="{Binding SelectedWan, Converter={StaticResource ToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Width="14" Height="14" Data="{Binding SelectedWan.Kind, Converter={StaticResource NicKindToIcon}}" />
                                        <TextBlock Margin="6,0,0,0" Text="{Binding SelectedWan.KindAndSpeed}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ComboBox Grid.Row="1" Margin="0,12,0,0" HorizontalContentAlignment="Stretch"
                                      ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedWan}"
                                      ItemTemplate="{StaticResource NicItemTemplate}" />
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding SelectedWan.InfoLine, FallbackValue=请选择一块网卡}"
                                           Visibility="{Binding WanGatewayError, Converter={StaticResource ToVisibility}, ConverterParameter=invert}" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ErrorBrush}" Text="{Binding WanGatewayError}"
                                           Visibility="{Binding WanGatewayError, Converter={StaticResource ToVisibility}}" />
                                <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Text="网关" />
                                <TextBox Grid.Column="2" FontFamily="{StaticResource MonoFont}" ToolTip="外网网关。自动填入，也可以手动修改"
                                         Text="{Binding WanGateway, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 互换内外网 -->
                    <Button x:Name="SwapButton" Grid.Row="1" Margin="0,-10" HorizontalAlignment="Center" Panel.ZIndex="2"
                            Style="{StaticResource RoundIconButtonStyle}" ToolTip="互换外网与内网"
                            c:IconAssist.Data="{StaticResource Icon.Swap}" Command="{Binding SwapCommand}" />

                    <!-- 内网网卡（青绿） -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid x:Name="LanCardContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}" Background="{DynamicResource LanBrush}">
                                    <c:Icon Width="22" Height="22" Data="{StaticResource Icon.Building}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="内网网卡" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="访问单位内网、设备网的专用出口" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource BadgeStyle}" Tag="Lan"
                                        Visibility="{Binding SelectedLan, Converter={StaticResource ToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Width="14" Height="14" Data="{Binding SelectedLan.Kind, Converter={StaticResource NicKindToIcon}}" />
                                        <TextBlock Margin="6,0,0,0" Text="{Binding SelectedLan.KindAndSpeed}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ComboBox Grid.Row="1" Margin="0,12,0,0" HorizontalContentAlignment="Stretch"
                                      ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedLan}"
                                      ItemTemplate="{StaticResource NicItemTemplate}" />
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding SelectedLan.InfoLine, FallbackValue=请选择一块网卡}"
                                           Visibility="{Binding LanGatewayError, Converter={StaticResource ToVisibility}, ConverterParameter=invert}" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ErrorBrush}" Text="{Binding LanGatewayError}"
                                           Visibility="{Binding LanGatewayError, Converter={StaticResource ToVisibility}}" />
                                <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Text="网关" />
                                <TextBox Grid.Column="2" FontFamily="{StaticResource MonoFont}" ToolTip="内网网关。自动填入；网卡没有配置网关时请手动填写"
                                         Text="{Binding LanGateway, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 路由拓扑图 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                    <c:RouteTopologyView x:Name="Topology"
                                         WanState="{Binding WanState}" LanState="{Binding LanState}"
                                         WanDetail="{Binding WanDetail}" LanDetail="{Binding LanDetail}"
                                         WanCaptionText="{Binding WanCaption}" LanCaptionText="{Binding LanCaption}"
                                         IsBusy="{Binding IsBusy}" />
                </Border>
            </Grid>

            <!-- ================= 内网目标网段 ================= -->
            <Border Grid.Row="3" Margin="0,14,0,0" Padding="16,10" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsIdle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Height="36" Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Top">
                        <c:Icon Width="18" Height="18" Foreground="{DynamicResource LanBrush}" Data="{StaticResource Icon.Route}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="内网目标网段" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Networks}"
                                  ItemTemplate="{StaticResource NetworkChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Grid Width="200">
                            <TextBox x:Name="NetworkInput" Height="36" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding NewNetworkText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddNetworkCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Text="如 10.20.0.0/16"
                                       Visibility="{Binding NewNetworkText, Converter={StaticResource ToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="添加"
                                c:IconAssist.Data="{StaticResource Icon.Plus}" Command="{Binding AddNetworkCommand}" />
                        <Button Margin="4,0,0,0" Height="36" Width="36" Style="{StaticResource IconButtonStyle}" ToolTip="恢复默认的三个私网网段"
                                c:IconAssist.Data="{StaticResource Icon.Restore}" Command="{Binding ResetNetworksCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="12"
                               Foreground="{DynamicResource ErrorBrush}" Text="{Binding NewNetworkError}"
                               Visibility="{Binding NewNetworkError, Converter={StaticResource ToVisibility}}" />
                </Grid>
            </Border>

            <!-- ================= 操作栏 ================= -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Height="40" Style="{StaticResource PrimaryButtonStyle}" Content="一键配置"
                            c:IconAssist.Data="{StaticResource Icon.Bolt}" c:IconAssist.Filled="True"
                            Command="{Binding ApplyCommand}" />
                    <Button Height="40" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="恢复原路由"
                            ToolTip="按最近一次备份恢复到配置前的状态"
                            c:IconAssist.Data="{StaticResource Icon.Restore}" Command="{Binding RestoreCommand}" />
                    <Button Height="40" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="刷新"
                            ToolTip="重新读取网卡与路由表"
                            c:IconAssist.Data="{StaticResource Icon.Refresh}" c:IconAssist.Spin="{Binding IsRefreshing}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- 中间：不能配置的原因，或分步进度 -->
                <Grid Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowBlockReason, Converter={StaticResource ToVisibility}}">
                        <c:Icon Width="15" Height="15" Foreground="{DynamicResource WarningBrush}" Data="{StaticResource Icon.Info}" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" Text="{Binding BlockReason}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"
                                  Visibility="{Binding ShowSteps, Converter={StaticResource ToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- 右侧：守护状态与设置 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource NeutralLineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGuardRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="c:Motion.Pulse" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="7,0,12,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding GuardStatusText}" />
                    <ToggleButton x:Name="GuardToggle" Height="40" Style="{StaticResource PopupToggleStyle}" Content="守护设置"
                                  c:IconAssist.Data="{StaticResource Icon.Sliders}" />
                    <Popup AllowsTransparency="True" Placement="Top" HorizontalOffset="-150" VerticalOffset="-2" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=GuardToggle}"
                           IsOpen="{Binding IsChecked, ElementName=GuardToggle, Mode=TwoWay}">
                        <Border Width="340" Style="{StaticResource FlyoutStyle}"
                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontFamily="{StaticResource UiFont}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="默认路由守护" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" TextTrimming="None"
                                           Text="DHCP 可能在配置后把内网网卡的默认路由重新装回来。守护会检查路由表，删除不在外网网卡上的默认路由。" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="配置完成后检查" />
                                    <TextBox Grid.Column="1" Text="{Binding GuardRounds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="轮" />
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="每轮间隔" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GuardIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="秒" />
                                </Grid>

                                <Border Height="1" Margin="0,14" Background="{DynamicResource DividerBrush}" />

                                <CheckBox Content="持续守护" IsChecked="{Binding PersistentGuard}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" TextTrimming="None"
                                           Text="配置生效后，在程序运行期间一直定时检查，应对 DHCP 续租或休眠唤醒后重新出现的默认路由。关闭程序即停止。" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="持续守护的检查间隔" />
                                    <TextBox Grid.Column="1" Text="{Binding PersistentGuardIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="秒" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- ================= 页签：操作日志 / 当前路由 / 备份历史 ================= -->
            <Border Grid.Row="5" Margin="0,14,0,0" Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="10,8,10,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource PillTabStyle}" Content="操作日志" c:IconAssist.Data="{StaticResource Icon.List}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource PillTabStyle}" Content="当前路由" c:IconAssist.Data="{StaticResource Icon.Route}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource PillTabStyle}" Content="备份历史" c:IconAssist.Data="{StaticResource Icon.History}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
                        </StackPanel>

                        <!-- 各页签自己的工具按钮 -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                            <Button Style="{StaticResource GhostButtonStyle}" Content="诊断信息" ToolTip="查看网卡识别结果与完整路由表（只读）"
                                    c:IconAssist.Data="{StaticResource Icon.Pulse}" Command="{Binding DiagnosticsCommand}" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="复制"
                                    c:IconAssist.Data="{StaticResource Icon.Copy}" Command="{Binding CopyLogCommand}" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="清空"
                                    c:IconAssist.Data="{StaticResource Icon.Trash}" Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding RouteSummary}" />
                            <CheckBox VerticalAlignment="Center" Content="显示全部路由" IsChecked="{Binding ShowAllRoutes}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                            <Button Style="{StaticResource GhostButtonStyle}" Content="打开备份目录" ToolTip="{Binding BackupDirectory}"
                                    c:IconAssist.Data="{StaticResource Icon.Folder}" Command="{Binding OpenBackupFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TabHost" Grid.Row="1">

                        <!-- 操作日志 -->
                        <Border Margin="1,0,1,1" CornerRadius="0,0,11,11" Background="{DynamicResource LogBackgroundBrush}"
                                Visibility="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                            <ListBox x:Name="LogList" Margin="4,6,2,6" Padding="8,0" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding Logs}" ItemTemplate="{StaticResource LogEntryTemplate}"
                                     ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.ScrollUnit="Pixel" />
                        </Border>

                        <!-- 当前路由 -->
                        <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderThickness="0,1,0,1" BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource LogBackgroundBrush}">
                                <Grid Height="30" Margin="16,0" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.7*" />
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="2.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="目标网段" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="网关" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="网卡" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="跃点" ToolTip="路由自身的跃点数。route print 显示的是它与接口跃点之和" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="来源"
                                               ToolTip="Windows 报告的路由来源。“配置”包括手动添加、DHCP 下发和程序添加的路由；“系统”是系统自动生成的路由" />
                                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="类别" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Routes}" ItemTemplate="{StaticResource RouteRowTemplate}" />
                            </ScrollViewer>
                        </Grid>

                        <!-- 备份历史 -->
                        <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                            <ScrollViewer Margin="0,0,0,4" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Snapshots}" ItemTemplate="{StaticResource SnapshotTemplate}" />
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasSnapshots, Converter={StaticResource ToVisibility}, ConverterParameter=invert}">
                                <c:Icon Width="34" Height="34" StrokeThickness="1.4" Foreground="{DynamicResource TextTertiaryBrush}" Data="{StaticResource Icon.History}" />
                                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="还没有备份。每次“一键配置”之前都会自动创建一份。" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
