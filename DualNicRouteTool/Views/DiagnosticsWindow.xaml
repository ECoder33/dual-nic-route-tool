<Window x:Class="DualNicRouteTool.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DualNicRouteTool.Controls"
        Title="诊断信息"
        Width="900" Height="640" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app_icon.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Border Background="{DynamicResource AppBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <c:Icon Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Data="{StaticResource Icon.Pulse}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="诊断信息" />
                <TextBlock Margin="12,0,0,1" VerticalAlignment="Bottom" Style="{StaticResource CaptionStyle}"
                           Text="只读：网卡识别结果、完整 IPv4 路由表与备份记录。不会修改任何系统设置。" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,12,0,0" Padding="0" Style="{StaticResource CardStyle}" Background="{DynamicResource LogBackgroundBrush}">
                <TextBox x:Name="ReportText" Margin="2" Padding="12,10" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="复制全部"
                            c:IconAssist.Data="{StaticResource Icon.Copy}" Click="OnCopy" />
                    <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="另存为 ..."
                            c:IconAssist.Data="{StaticResource Icon.Folder}" Click="OnSave" />
                    <Button MinWidth="84" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="关闭"
                            IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
